{
  "name": "cloudscope-mcp",
  "version": "0.1.1",
  "description": "Cloud cost management MCP server. Azure supported, GCP coming soon.",
  "type": "module",
  "bin": {
    "cloudscope-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "validate": "npm run lint && npm run typecheck && npm run build && npm run test",
    "security": "npm audit --audit-level=high",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure",
    "cloud-cost",
    "cost-management",
    "finops",
    "cost-optimization",
    "azure-advisor",
    "cloud-billing",
    "ai-tools",
    "claude",
    "cursor",
    "devops",
    "infrastructure",
    "cost-analysis",
    "budget-monitoring",
    "cost-forecast"
  ],
  "license": "MIT",
  "author": "Alex Potapenko <alex.potapenko.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpota/cloudscope-mcp.git"
  },
  "homepage": "https://github.com/alexpota/cloudscope-mcp#readme",
  "bugs": {
    "url": "https://github.com/alexpota/cloudscope-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@azure/arm-advisor": "^3.0.0",
    "@azure/arm-consumption": "^9.0.0",
    "@azure/arm-costmanagement": "1.0.0-beta.2",
    "@azure/identity": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.0.0"
  }
}
