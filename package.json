{
  "name": "cloudscope-mcp",
  "version": "0.3.3",
  "mcpName": "io.github.alexpota/cloudscope",
  "description": "Multi-cloud cost management MCP server (Azure + GCP): spending, forecasts, anomalies, budgets, idle resources, tags.",
  "type": "module",
  "bin": {
    "cloudscope-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E_AZURE=true vitest run --config vitest.e2e.config.ts",
    "test:e2e:gcp": "E2E_GCP=true vitest run --config vitest.e2e.config.ts",
    "test:e2e:all": "E2E_AZURE=true E2E_GCP=true vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "validate": "npm run lint && npm run typecheck && npm run build && npm run test",
    "security": "npm audit --audit-level=high",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure",
    "gcp",
    "google-cloud",
    "cloud-cost",
    "cost-management",
    "finops",
    "cost-optimization",
    "azure-advisor",
    "gcp-recommender",
    "bigquery",
    "cloud-billing",
    "ai-tools",
    "claude",
    "cursor",
    "devops",
    "infrastructure",
    "cost-analysis",
    "budget-monitoring",
    "cost-forecast",
    "multi-cloud"
  ],
  "license": "MIT",
  "author": "Alex Potapenko <alex.potapenko.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpota/cloudscope-mcp.git"
  },
  "homepage": "https://github.com/alexpota/cloudscope-mcp#readme",
  "bugs": {
    "url": "https://github.com/alexpota/cloudscope-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@azure/arm-advisor": "^3.0.0",
    "@azure/arm-consumption": "^9.0.0",
    "@azure/arm-costmanagement": "1.0.0-beta.2",
    "@azure/arm-resourcegraph": "^4.2.1",
    "@azure/arm-resources-subscriptions": "^2.1.0",
    "@azure/identity": "^4.0.0",
    "@google-cloud/asset": "^6.3.1",
    "@google-cloud/bigquery": "^8.3.0",
    "@google-cloud/billing-budgets": "^6.1.1",
    "@google-cloud/compute": "^6.9.0",
    "@google-cloud/recommender": "^7.2.1",
    "@google-cloud/resource-manager": "^6.2.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.0.0"
  }
}
