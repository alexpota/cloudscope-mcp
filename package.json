{
  "name": "cloudscope-mcp",
  "version": "0.1.0",
  "description": "Cloud cost management MCP server. Azure supported, GCP coming soon.",
  "type": "module",
  "bin": {
    "cloudscope-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "cloud",
    "cost",
    "azure",
    "finops",
    "ai"
  ],
  "license": "MIT",
  "author": "Alex Pota (https://github.com/alexpota)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpota/cloudscope-mcp.git"
  },
  "homepage": "https://github.com/alexpota/cloudscope-mcp#readme",
  "bugs": {
    "url": "https://github.com/alexpota/cloudscope-mcp/issues"
  },
  "dependencies": {
    "@azure/arm-advisor": "^3.0.0",
    "@azure/arm-consumption": "^9.0.0",
    "@azure/arm-costmanagement": "1.0.0-beta.2",
    "@azure/identity": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "eslint": "^10.2.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.0.0"
  }
}
