{
  "name": "cloudscope-mcp",
  "version": "0.1.0",
  "description": "Multi-cloud cost management MCP server for Azure and GCP",
  "type": "module",
  "bin": {
    "cloudscope-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": ["mcp", "cloud", "cost", "azure", "gcp", "finops", "ai"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0",
    "@azure/identity": "^4.0.0",
    "@azure/arm-costmanagement": "1.0.0-beta.2",
    "@azure/arm-advisor": "^3.0.0",
    "@azure/arm-consumption": "^9.0.0",
    "@google-cloud/bigquery": "^7.0.0",
    "@google-cloud/recommender": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22",
    "vitest": "^3.0.0"
  }
}
